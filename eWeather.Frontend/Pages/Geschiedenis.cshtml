@page
@model GeschiedenisModel
@{
    ViewData["Title"] = "Geschiedenis";
}

@{
    var dataIsOpgehaald = Model.Data != null;
}

@{
    var gesorteerdeLijst = Model.Data.OrderBy(c => c.Regio);
}

@if (Model.FoutMelding != null)
{
    <p class="fout">@Model.FoutMelding</p>
}

@if (dataIsOpgehaald)
{
    <form method="get" class="form-stad">
        <select class="dropdown-stad" name="GekozenWeerStation">

            <option value="">Kies een weerstation</option>
            @foreach (var x in gesorteerdeLijst)
            {
                @if (Model.GekozenWeerStation != x.Station)
                {
                    <option value="@x.Station">@x.Regio</option>
                }
                else
                {
                    <option value="@x.Station" selected>@x.Regio</option>
                }

            }
        </select>

        <div>
            <label for="StartDate">Van:</label>
            @if (Model.StartDate != default)
            {
                
                <input type="date" id="StartDate" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            }
            else
            {
                <input type="date" id="StartDate" name="StartDate" />
            }
            <label for="EndDate">Tot:</label>
            @if (Model.EndDate.HasValue)
            {
                <input type="date" id="EndDate" name="EndDate" value="@Model.EndDate.Value.ToString("yyyy-MM-dd")" />
            }
            else
            {
                <input type="date" id="EndDate" name="EndDate" />
            }

            <button class="button-stad" type="submit">Toon weerstation</button>
        </div>
    </form>


    @if (Model.DataPeriodeStation != null && Model.DataPeriodeStation.Any())
    {
        // var gekozenPlek = Model.Data.Actual.StationMeasurements
        var gekozenPlek = Model.DataPeriodeStation;
        <div class=mainContent>
        <table>
            <thead>
                <tr>
                    <th>Tijdstip</th>
                    <th>temperatuur</th>
                    <th>gevoelstemperatuur</th>
                    <th>grondtemperatuur</th>
                </tr>
            </thead>
            @foreach (var x in gekozenPlek)
            {
                <tr>
                    <td>@x.Tijdstip.ToString("yyyy-MM-dd")</td>
                    <td>@x.Temperature</td>
                    <td>@x.FeelTemperature</td>
                    <td>@x.GroundTemperature</td>
                </tr>
            }
        </table></div>

    }
    else
    {
        <div class=mainContent><p>Kies een weerstation om de meting te zien.</p></div>
    }
}
