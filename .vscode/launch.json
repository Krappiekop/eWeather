{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "eWeather.Backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/eWeather.Backend/bin/Debug/net10.0/eWeather.Backend.dll",
      "args": [],
      "cwd": "${workspaceFolder}/eWeather.Backend",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5075"
      }
    },
    {
      "name": "eWeather.Frontend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-frontend",
      "program": "${workspaceFolder}/eWeather.Frontend/bin/Debug/net10.0/eWeather.Frontend.dll",
      "args": [],
      "cwd": "${workspaceFolder}/eWeather.Frontend",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://localhost:5158)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5158"
      }
    }
  ],
  "compounds": [
    {
      "name": "Backend + Frontend",
      "configurations": ["eWeather.Backend", "eWeather.Frontend"],
      "preLaunchTask": "build",
      "stopAll": true
    }
  ]
}